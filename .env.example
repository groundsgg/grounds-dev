# Environment variables for Grounds Development Infrastructure
# Copy this file to .env and fill in your credentials
# The .env file is git-ignored and will not be committed

# Docker Hub credentials (for k3d registry mirror configuration)
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-token

# GitHub Container Registry (GHCR) credentials
# Create a Personal Access Token (PAT) with 'read:packages' permission at:
# https://github.com/settings/tokens
GHCR_USERNAME=your-github-username
GHCR_TOKEN=your-github-pat-token

# Local domain for ingress (used by mkcert for TLS certificates)
# Uses sslip.io for automatic DNS resolution — no /etc/hosts needed
# Subdomains like demo.127.0.0.1.sslip.io, api.127.0.0.1.sslip.io resolve automatically
LOCAL_DOMAIN=127.0.0.1.sslip.io
